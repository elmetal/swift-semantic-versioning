import SemVer

/-!
# Swift 実装との差分テスト用ベクタの生成

証明済みの参照パーサ(`SemVer.parse`)と実装モデル(`Components.Lt`)を実行して、
Swift 側のテストが読むファイルを書き出す。

```
lake exe vectors ../Tests/SemanticVersioningTests/Vectors
```

* `grammar.txt`: 決めたアルファベット上の文字列を全数列挙し、妥当なものだけを並べる。
  Swift 側は同じ集合を列挙し、妥当と判定する文字列がこの一覧とちょうど一致することを確かめる。
* `precedence.txt`: 見本のバージョンを優先順位の昇順に並べる。1 行が優先順位の等しい 1 組。
* `byte-classes.txt`: 256 個のバイトそれぞれの文字クラス。
-/

open SemVer SemVer.Spec

namespace Vectors

def ascii (s : List Byte) : String :=
  String.ofList (s.map fun b => Char.ofNat b.toNat)

def bytes (s : String) : List Byte := s.toUTF8.toList

def hexDigit (n : Nat) : Char := "0123456789ABCDEF".toList.getD n '?'

def hex (b : Byte) : String :=
  String.ofList [hexDigit (b.toNat / 16), hexDigit (b.toNat % 16)]

/-! ## 文法 -/

/--
全数列挙に使うアルファベット。実装が区別するバイトの種類ごとに代表を 1 つずつ選ぶ:
`0`、0 以外の数字、英字、`-`、`.`、`+`、それ以外。
-/
def alphabet : List Byte := [0x30, 0x31, 0x61, 0x2D, 0x2E, 0x2B, 0x21]

def visit (rev : List Byte) (acc : Array String) : Array String :=
  let s := rev.reverse
  if (parse s).isSome then acc.push (ascii s) else acc

/-- `rev` を逆順にした文字列と、その後ろに `fuel` 文字まで続けた文字列のうち、妥当なものを集める。 -/
def collectValid : Nat → List Byte → Array String → Array String
  | 0, rev, acc => visit rev acc
  | fuel + 1, rev, acc =>
    alphabet.foldl (fun acc c => collectValid fuel (c :: rev) acc) (visit rev acc)

/-- 列挙する範囲。(接頭辞, その後ろに続ける最大文字数)。 -/
def sections : List (String × Nat) :=
  [("", 7), ("0.0.0", 5), ("0.0.0-0", 4), ("0.0.0-a", 4), ("0.0.0+0", 4)]

def grammarFile : String := Id.run do
  let mut lines : Array String := #[
    "# Generated by `lake exe vectors`. Do not edit.",
    "alphabet " ++ " ".intercalate (alphabet.map hex)]
  for (pre, extra) in sections do
    lines := lines.push (if pre.isEmpty then s!"section {extra}" else s!"section {extra} {pre}")
    lines := collectValid extra (bytes pre).reverse lines
  return "\n".intercalate lines.toList ++ "\n"

/-! ## 文字クラス -/

def classFlags (b : Byte) : String :=
  let flags : List Char :=
    (if IsPositiveDigit b then ['p'] else []) ++
    (if IsDigit b then ['d'] else []) ++
    (if IsLetter b then ['l'] else []) ++
    (if IsNonDigit b then ['n'] else []) ++
    (if IsIdentifierCharacter b then ['i'] else [])
  if flags.isEmpty then "-" else String.ofList flags

def byteClassFile : String :=
  let header := [
    "# Generated by `lake exe vectors`. Do not edit.",
    "# p: positive digit, d: digit, l: letter, n: non-digit, i: identifier character"]
  let rows := (List.range 256).map fun n => s!"{hex n.toUInt8} {classFlags n.toUInt8}"
  "\n".intercalate (header ++ rows) ++ "\n"

/-! ## 優先順位 -/

def sampleStrings : List String :=
  let majors := ["0", "1", "2", "10"]
  let minors := ["0", "1", "10"]
  let patches := ["0", "9", "10"]
  let cores : List String :=
    majors.flatMap fun x => minors.flatMap fun y => patches.map fun z => s!"{x}.{y}.{z}"
  let pres := [
    "0", "1", "2", "9", "10", "11", "100", "0a", "a", "A", "Z", "z", "-", "--", "a-", "a0",
    "ab", "b", "0.0", "0.a", "a.0", "a.1", "a.10", "a.a", "a.b", "a.0.0", "alpha", "alpha.1",
    "alpha.beta", "beta", "beta.2", "beta.11", "rc.1"]
  let builds := ["b", "0.b"]
  cores
    ++ (cores.flatMap fun c => pres.map fun p => s!"{c}-{p}")
    ++ (cores.flatMap fun c => builds.map fun b => s!"{c}+{b}")
    ++ (cores.flatMap fun c => builds.map fun b => s!"{c}-a+{b}")
    ++ [
      "18446744073709551615.0.0",
      "18446744073709551616.0.0",
      "99999999999999999999999.0.0",
      "100000000000000000000000.0.0",
      "1.18446744073709551616.0",
      "1.0.18446744073709551616",
      "1.0.0-18446744073709551615",
      "1.0.0-18446744073709551616",
      "1.0.0-99999999999999999999999",
      "1.0.0-a.18446744073709551616"]

def precedenceFile : Except String String := do
  let parsed ← sampleStrings.mapM fun s =>
    match parse (bytes s) with
    | some c => pure (s, c)
    | none => throw s!"sample does not parse: {s}"
  let sorted := parsed.toArray.qsort (fun x y => decide (x.2.Lt y.2))
  let mut classes : Array (Array String) := #[]
  let mut last : Option Components := none
  for (s, c) in sorted do
    match last with
    | some l =>
      if l.PrecedenceEq c then
        classes := classes.modify (classes.size - 1) (·.push s)
      else
        classes := classes.push #[s]
    | none => classes := classes.push #[s]
    last := some c
  let header := [
    "# Generated by `lake exe vectors`. Do not edit.",
    "# One line per precedence class, in ascending order of precedence."]
  let rows := classes.toList.map fun cls => " ".intercalate cls.toList
  return "\n".intercalate (header ++ rows) ++ "\n"

end Vectors

def main (args : List String) : IO UInt32 := do
  match args with
  | [dir] =>
    let dir : System.FilePath := dir
    match Vectors.precedenceFile with
    | .error e =>
      IO.eprintln e
      return 1
    | .ok precedence =>
      IO.FS.createDirAll dir
      IO.FS.writeFile (dir / "grammar.txt") Vectors.grammarFile
      IO.FS.writeFile (dir / "byte-classes.txt") Vectors.byteClassFile
      IO.FS.writeFile (dir / "precedence.txt") precedence
      return 0
  | _ =>
    IO.eprintln "usage: vectors <output-directory>"
    return 1
